# Copy to .env.local for local development. In production these live in Vercel
# (Project > Settings > Environment Variables), with 1Password as the source of truth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). The publishable key is safe in the browser;
# never put the secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Build-time only (Vercel): lets the build upload source maps to Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
