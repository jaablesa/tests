# Copy to .env.local for local development. In production these live in Vercel
# (Project > Settings > Environment Variables), sourced from 1Password.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Build-time only (Vercel): lets the build upload source maps to Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
